<!-- Cache (update downloads, driver imports) must not be backed up or
     transferred: it is re-creatable and bloats every backup. Save data,
     trophies and settings stay included by default. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
